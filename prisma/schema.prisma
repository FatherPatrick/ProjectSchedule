generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Platform / SaaS models
// ---------------------------------------------------------------------------

model Salon {
  id              String      @id @default(cuid())
  /// URL subdomain, e.g. "polished" in polished.app.com. Lowercase, unique.
  /// Immutable after creation — slugs appear in every client-facing link.
  slug            String      @unique
  name            String
  timezone        String      @default("America/Los_Angeles")
  instagram       String?
  /// Primary brand color (hex, validated). Drives buttons, links, primary accents.
  brandColor      String      @default("#db2777") // current pink-600
  /// Secondary accent color (hex, validated). Independently editable.
  accentColor     String      @default("#db2777") // defaults to brand until customized
  /// Page/background tint (hex, validated). Was `themeColor` pre-appearance-theming.
  backgroundColor String      @default("#fdf2f8") // current pink-50-ish tint
  /// Curated font key, e.g. "geist" | "playfair" | "poppins". Maps to a bundled font.
  fontKey         String      @default("geist")
  /// Vercel Blob URL of the uploaded logo; null → render the salon name as text.
  logoUrl         String?

  // Stripe Connect (docs/STRIPE_SPEC.md, inert until paymentsEnabled + charges pass)
  stripeAccountId        String?      @unique
  stripeChargesEnabled   Boolean      @default(false)
  stripePayoutsEnabled   Boolean      @default(false)
  stripeDetailsSubmitted Boolean      @default(false)
  stripeAccountUpdatedAt DateTime?
  paymentsEnabled        Boolean      @default(false)
  paymentMode            PaymentMode  @default(NONE)
  depositCents           Int?
  depositPercent         Int?
  depositType            DepositType  @default(FIXED)
  currency               String       @default("usd")

  status          SalonStatus @default(ACTIVE)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  services      Service[]
  clients       Client[]
  appointments  Appointment[]
  blackouts     Blackout[]
  businessHours BusinessHours[]
  hoursSchedule BusinessHoursSchedule[]
  setting       Setting?
  admins        User[]
  adminPhones   AdminPhone[]
  payments      Payment[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// Auth / identity models (unchanged except salonId on User)
// ---------------------------------------------------------------------------

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String          @unique
  emailVerified  DateTime?
  image          String?
  phone          String?
  role           Role            @default(CLIENT)
  /// Null for platform super-admins (future). All current admins have a salon.
  salonId        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accounts       Account[]
  client         Client?
  sessions       Session[]
  mobileSessions MobileSession[]
  invitedAdmins  AdminPhone[]    @relation("AdminPhoneInviter")
  salon          Salon?          @relation(fields: [salonId], references: [id])

  @@index([salonId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Tenant-owned models — all gain a nullable salonId in this migration.
// salonId is made non-nullable + unique constraints updated in the follow-up
// migration after the backfill script runs.
// ---------------------------------------------------------------------------

model Service {
  id              String        @id @default(cuid())
  salonId         String
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int
  active          Boolean       @default(true)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  appointments    Appointment[]
  salon           Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId])
}

model Client {
  id           String        @id @default(cuid())
  salonId      String
  userId       String?       @unique
  name         String
  email        String
  phone        String
  emailOptIn   Boolean       @default(true)
  smsOptIn     Boolean       @default(true)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id])

  @@index([salonId, email])
  @@index([salonId, phone])
}

model Appointment {
  id              String            @id @default(cuid())
  salonId         String
  clientId        String
  serviceId       String
  startsAt        DateTime
  endsAt          DateTime
  status          AppointmentStatus @default(CONFIRMED)
  notes           String?
  managementToken String            @unique
  reminderSentAt  DateTime?
  /// Set when status = PENDING_PAYMENT; the slot is reserved until this time
  /// (docs/STRIPE_SPEC.md §1.3). Cleared once payment succeeds or the hold expires.
  holdExpiresAt   DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service         Service           @relation(fields: [serviceId], references: [id])
  salon           Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  notifications   NotificationLog[]
  payments        Payment[]

  @@index([salonId, startsAt])
  @@index([salonId, status, startsAt])
  // Covers the once-a-day reminder cron query.
  @@index([salonId, status, reminderSentAt, startsAt])
}

model Blackout {
  id        String   @id @default(cuid())
  salonId   String
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId, startsAt, endsAt])
}

model BusinessHours {
  id        String  @id @default(cuid())
  salonId   String
  dayOfWeek Int
  openMin   Int
  closeMin  Int
  active    Boolean @default(true)
  salon     Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([salonId, dayOfWeek])
}

/// Future-dated business-hours overrides. The schedule with the greatest
/// `effectiveFrom <= date` provides that date's hours; if none exists the
/// row in `BusinessHours` for that dayOfWeek is used.
model BusinessHoursSchedule {
  id            String   @id @default(cuid())
  salonId       String
  effectiveFrom DateTime // midnight UTC of the date the change takes effect (date-only semantics)
  dayOfWeek     Int
  openMin       Int
  closeMin      Int
  active        Boolean  @default(true)
  note          String?
  createdAt     DateTime @default(now())
  salon         Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([salonId, effectiveFrom, dayOfWeek])
  @@index([salonId, effectiveFrom])
}

model Setting {
  id                   String  @id
  /// One-to-one with Salon. Populated by the backfill script; made non-nullable
  /// and used as the primary lookup key after the Phase 1c migration.
  salonId              String? @unique
  slotGranularityMin   Int
  allowStartAtClose    Boolean @default(false)
  /// How far in advance clients may book, in days. NULL means no limit.
  maxAdvanceDays       Int?
  /// When true, marking an appointment COMPLETED fires a review-request email/SMS.
  reviewRequestEnabled Boolean @default(false)
  /// URL clients are directed to when leaving a review (e.g. Google Maps review link).
  reviewRequestUrl     String?
  salon                Salon?  @relation(fields: [salonId], references: [id])
}

/// DB-managed admin allow-list. A phone is an admin of a specific salon.
/// Composite PK enforced after the Phase 4 migration backfills salonId.
model AdminPhone {
  /// E.164 phone number, e.g. "+15555551212".
  phone       String
  salonId     String
  /// When true, this admin receives an SMS when a client books or requests an
  /// appointment.
  notify      Boolean  @default(true)
  createdAt   DateTime @default(now())
  /// User.id of the admin who invited this phone.
  createdById String?
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation("AdminPhoneInviter", fields: [createdById], references: [id], onDelete: SetNull)

  @@id([salonId, phone])
  @@index([createdById])
}

/// Long-lived refresh-token session for the mobile admin app.
model MobileSession {
  id          String    @id @default(cuid())
  userId      String
  refreshHash String    @unique
  deviceLabel String?
  pushToken   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pushToken])
}

model NotificationLog {
  id            String              @id @default(cuid())
  appointmentId String
  channel       NotificationChannel
  kind          NotificationKind
  status        NotificationStatus
  providerId    String?
  error         String?
  sentAt        DateTime            @default(now())
  appointment   Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([appointmentId, kind])
  @@index([status, sentAt])
}

/// One row per payment attempt against an appointment (docs/STRIPE_SPEC.md
/// §1.2). Local source of truth for the billing dashboard; reconciled with
/// Stripe via webhooks. Not unique on appointmentId: a hold-expiry retry
/// creates a new row, so history is preserved.
model Payment {
  id                    String        @id @default(cuid())
  salonId               String
  appointmentId         String
  stripePaymentIntentId String        @unique
  /// The connected account the charge lives on (denormalized for reconciliation).
  stripeAccountId       String
  amountCents           Int
  applicationFeeCents   Int
  currency              String
  status                PaymentStatus
  /// Total refunded so far, in cents (supports partial refunds).
  refundedCents         Int           @default(0)
  /// What this payment represents at the time of charge.
  kind                  PaymentKind
  failureReason         String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  salon       Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([salonId, status, createdAt]) // billing dashboard queries
  @@index([appointmentId])
}

/// Dedupe guard for the Stripe webhook (docs/STRIPE_SPEC.md §5) — Stripe
/// retries delivery, so each `event.id` is recorded once processed and any
/// replay is a no-op.
model ProcessedStripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CLIENT
  ADMIN
}

enum SalonStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum AppointmentStatus {
  PENDING
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentMode {
  NONE
  DEPOSIT
  FULL
}

enum DepositType {
  FIXED
  PERCENT
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentKind {
  DEPOSIT
  FULL
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
}

enum NotificationKind {
  CONFIRMATION
  REMINDER_24H
  CANCELLATION
  REVIEW_REQUEST
}

enum NotificationStatus {
  SENT
  FAILED
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String          @unique
  emailVerified  DateTime?
  image          String?
  phone          String?
  role           Role            @default(CLIENT)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accounts       Account[]
  client         Client?
  sessions       Session[]
  mobileSessions MobileSession[]
  invitedAdmins  AdminPhone[]    @relation("AdminPhoneInviter")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Service {
  id              String        @id @default(cuid())
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int
  active          Boolean       @default(true)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  appointments    Appointment[]
}

model Client {
  id           String        @id @default(cuid())
  userId       String?       @unique
  name         String
  email        String
  phone        String
  emailOptIn   Boolean       @default(true)
  smsOptIn     Boolean       @default(true)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  user         User?         @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([phone])
}

model Appointment {
  id              String            @id @default(cuid())
  clientId        String
  serviceId       String
  startsAt        DateTime
  endsAt          DateTime
  status          AppointmentStatus @default(CONFIRMED)
  notes           String?
  managementToken String            @unique
  reminderSentAt  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service         Service           @relation(fields: [serviceId], references: [id])
  notifications   NotificationLog[]

  @@index([startsAt])
  @@index([status, startsAt])
  // Covers the once-a-day reminder cron query
  // (status=CONFIRMED AND reminderSentAt IS NULL AND startsAt BETWEEN x..y).
  // See src/app/api/cron/reminders/route.ts.
  @@index([status, reminderSentAt, startsAt])
}

model Blackout {
  id        String   @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([startsAt, endsAt])
}

model BusinessHours {
  id        String  @id @default(cuid())
  dayOfWeek Int     @unique
  openMin   Int
  closeMin  Int
  active    Boolean @default(true)
}

/// Future-dated business-hours overrides. The schedule with the greatest
/// `effectiveFrom <= date` provides that date's hours; if none exists the
/// row in `BusinessHours` for that dayOfWeek is used.
model BusinessHoursSchedule {
  id            String   @id @default(cuid())
  effectiveFrom DateTime // midnight UTC of the date the change takes effect (date-only semantics)
  dayOfWeek     Int
  openMin       Int
  closeMin      Int
  active        Boolean  @default(true)
  note          String?
  createdAt     DateTime @default(now())

  @@unique([effectiveFrom, dayOfWeek])
  @@index([effectiveFrom])
}

model Setting {
  id                 String  @id
  slotGranularityMin Int
  allowStartAtClose  Boolean @default(false)
}

/// DB-managed admin allow-list. A phone is considered an admin if it
/// appears here OR in the `ADMIN_PHONES` env (env is the bootstrap
/// fallback). New admins added via the admin UI go here so the list can
/// be edited at runtime without redeploying.
model AdminPhone {
  /// E.164 phone number, e.g. "+15555551212".
  phone       String   @id
  createdAt   DateTime @default(now())
  /// User.id of the admin who invited this phone. Nullable so legacy
  /// rows / SQL-seeded entries don't require a backref.
  createdById String?
  createdBy   User?    @relation("AdminPhoneInviter", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

/// Long-lived refresh-token session for the mobile admin app. The refresh
/// token itself is never stored; only its SHA-256 hash. Short-lived access
/// tokens (signed JWT-like HMAC tokens) are issued from these sessions.
model MobileSession {
  id          String    @id @default(cuid())
  userId      String
  refreshHash String    @unique
  deviceLabel String?
  pushToken   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pushToken])
}

model NotificationLog {
  id            String              @id @default(cuid())
  appointmentId String
  channel       NotificationChannel
  kind          NotificationKind
  status        NotificationStatus
  providerId    String?
  error         String?
  sentAt        DateTime            @default(now())
  appointment   Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  // Lookups like "did we already send a CONFIRMATION for this appt?"
  @@index([appointmentId, kind])
  // Operational queries: "all failed sends in the last hour", etc.
  @@index([status, sentAt])
}

enum Role {
  CLIENT
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
}

enum NotificationKind {
  CONFIRMATION
  REMINDER_24H
  CANCELLATION
}

enum NotificationStatus {
  SENT
  FAILED
}
